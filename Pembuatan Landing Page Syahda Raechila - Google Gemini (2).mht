@import url("https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&display=swap");

body { font-family: Quicksand, sans-serif; background-color: rgb(243, 232, 255); color: rgb(76, 29, 149); }

.glass-panel { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); border-radius: 24px; border: 2px solid rgba(255, 255, 255, 0.5); box-shadow: rgba(139, 92, 246, 0.1) 0px 10px 15px -3px, rgba(139, 92, 246, 0.05) 0px 4px 6px -2px; }

.btn-modern { transition: 0.2s ease-in-out; border-bottom-width: 4px; }

.btn-modern:hover { transform: translateY(-2px); }

.btn-modern:active { transform: translateY(2px); border-bottom-width: 2px; margin-bottom: 2px; }

.btn-lilac { background-color: rgb(167, 139, 250); border-color: rgb(124, 58, 237); color: white; }

.btn-lilac:hover { background-color: rgb(139, 92, 246); }

.btn-game-1 { background-color: rgb(96, 165, 250); border-color: rgb(37, 99, 235); color: white; }

.btn-game-2 { background-color: rgb(244, 114, 182); border-color: rgb(219, 39, 119); color: white; }

.btn-game-3 { background-color: rgb(74, 222, 128); border-color: rgb(22, 163, 74); color: white; }

@keyframes popIn { 
  0% { transform: scale(0.9); opacity: 0; }
  70% { transform: scale(1.05); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.animate-pop { animation: 0.4s ease-out 0s 1 normal forwards running popIn; }

@keyframes shake { 
  10%, 90% { transform: translate3d(-1px, 0px, 0px); }
  20%, 80% { transform: translate3d(2px, 0px, 0px); }
  30%, 50%, 70% { transform: translate3d(-4px, 0px, 0px); }
  40%, 60% { transform: translate3d(4px, 0px, 0px); }
}

.animate-shake { animation: 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) 0s 1 normal both running shake; }

@keyframes float { 
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

.animate-float { animation: 3s ease-in-out 0s infinite normal none running float; }

.color-dot { width: 50px; height: 50px; border-radius: 50%; border: 4px solid white; box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 6px; }
