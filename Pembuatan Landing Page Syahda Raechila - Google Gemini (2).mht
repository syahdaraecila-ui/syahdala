@import url("https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&display=swap");

body { font-family: Quicksand, sans-serif; background-color: rgb(243, 232, 255); color: rgb(76, 29, 149); }

.glass-panel { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); border-radius: 24px; border: 2px solid rgba(255, 255, 255, 0.5); box-shadow: rgba(139, 92, 246, 0.1) 0px 10px 15px -3px, rgba(139, 92, 246, 0.05) 0px 4px 6px -2px; }

.btn-modern { transition: 0.2s ease-in-out; border-bottom-width: 4px; }

.btn-modern:hover { transform: translateY(-2px); }

.btn-modern:active { transform: translateY(2px); border-bottom-width: 2px; margin-bottom: 2px; }

.btn-lilac { background-color: rgb(167, 139, 250); border-color: rgb(124, 58, 237); color: white; }

